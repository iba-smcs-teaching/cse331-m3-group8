# ===========================================
#  Build Artifacts (C / C++)
# ===========================================
# Object and binary files
*.o
*.a
*.so
*.out
*.exe
*.hex

# Compiled binaries from llama2c builds
run
runq
bench_*
test_*

# ===========================================
#  LLaMA2C Project-Specific
# ===========================================
# Model binaries and checkpoints — heavy, not for git
llama2c/models/

# The 110M checkpoint is ~418 MiB and is fetched on demand (see README "Weight
# server"); stories15M.bin and tokenizer.bin stay tracked.
server/models/stories110M.bin

# Raw perf data (binary profiling traces)
perf.data
perf.data.old

# ===========================================
#  Editor and Environment Files
# ===========================================
.vscode/
.idea/
*.code-workspace
.temp/

# ===========================================
#  Python Helper Scripts (if any)
# ===========================================
__pycache__/
*.pyc
.venv/
venv/

# ===========================================
#  Other script files
# ===========================================
*.sh

# ===========================================
#  Temporary and Log Files
# ===========================================
*.tmp
logs/

# ===========================================
#  Keep Useful Data / Reports
# ===========================================
# Keep all results/ files (do NOT ignore results/)
# Keep text and CSV outputs
!*.txt
!*.csv

# ===========================================
#  Documentation Files
# ===========================================
# Ignore Temporarily 
docs/

# ===========================================
#  End of .gitignore
# ===========================================

# Classroom 50 check output
!.github/ci/*.sh
.github/ci/out/
